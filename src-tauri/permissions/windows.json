{
  "permission": [
    {
      "identifier": "editor-commands",
      "description": "Editor-only explicit capture, save, copy and pin actions",
      "commands": {
        "allow": [
          "start_capture",
          "get_current_image",
          "take_pending_pin_edit",
          "finish_pin_edit",
          "save_image",
          "copy_image",
          "pin_image",
          "get_app_status",
          "cancel_capture",
          "get_update_status",
          "check_starshot_update",
          "download_starshot_update",
          "set_update_confirmation",
          "install_starshot_update",
          "list_recovery_points",
          "create_recovery_point",
          "read_recovery_point",
          "restart_app",
          "get_desktop_settings",
          "set_desktop_settings",
          "set_editor_state",
          "request_exit",
          "cancel_exit",
          "confirm_exit",
          "cancel_idle_release",
          "release_empty_editor",
          "get_recovery_storage",
          "delete_recovery_point",
          "copy_text",
          "reveal_saved_image",
          "recognize_text"
        ]
      }
    },
    {
      "identifier": "capture-commands",
      "description": "A capture overlay can read only its own frozen frame, explicitly edit/copy/save/pin its selection, start and explicitly append/finish a scroll capture, or cancel that capture",
      "commands": {
        "allow": [
          "get_capture_frame",
          "get_capture_element",
          "invalidate_capture_element",
          "native_smoke_report",
          "native_smoke_move",
          "native_integration_record",
          "finish_capture",
          "begin_scroll_capture",
          "append_scroll_capture",
          "finish_scroll_capture",
          "cancel_capture"
        ]
      }
    },
    {
      "identifier": "pin-commands",
      "description": "A pin can read, control, and explicitly copy/save/edit only its own image",
      "commands": {
        "allow": [
          "get_pin_image",
          "pin_action",
          "pin_export"
        ]
      }
    }
  ]
}
