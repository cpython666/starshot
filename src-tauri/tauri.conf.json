{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starshot",
  "version": "0.3.0",
  "identifier": "com.starshot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "星镜 Starshot",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "models/ocrs/NOTICE.md",
      "models/ocrs/LICENSE-CC-BY-SA-4.0.txt",
      "models/ocrs/LICENSE-OCR-CODE.txt"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "星镜 — 截住灵感，照亮画面",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMjJDN0U5Q0NGMUVBMDcKUldRSDZ2SE02Y2NpUDdqM3NYa2l2bldsWDlEdXBRd3YrVmdvZGlWa1BZTlZwWjNaUlZWODFEdGYK",
      "endpoints": [
        "https://github.com/cpython666/starshot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
